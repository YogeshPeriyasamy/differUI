# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# API base URL — no trailing slash. Leave blank to use the browser's host
# on port 4000, which works when the frontend and API run on this machine.
VITE_API_BASE=

# Login credentials (simple auth — replace with a real auth service for production)
VITE_ADMIN_EMAIL=admin@medtrix.com
VITE_ADMIN_PASSWORD=
